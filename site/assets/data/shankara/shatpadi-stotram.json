          "sa": "अवता",
          "en": "protected"
        },
        {
          "sa": "सदा",
          "en": "always"
        },
        {
          "sa": "वसुधाम्",
          "en": "the earth"
        },
        {
          "sa": "परम-ईश्वर",
          "en": "O Supreme Lord"
        },
        {
          "sa": "परिपाल्यः",
