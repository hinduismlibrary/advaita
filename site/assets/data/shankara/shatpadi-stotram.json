  "units": [
    {
      "id": "shatpadi-1",
      "label": "Verse 1",
      "number": "1",
      "deva": "अविनयमपनय विष्णो दमय मनः शमय विषयमृगतृष्णाम् ।\nभूतदयां विस्तारय तारय संसारसागरात् ॥",
      "translation": "Remove my arrogance, Viṣṇu; discipline my mind; quiet the mirage-thirst for sense objects. Expand my compassion for living beings and carry me across the ocean of worldly existence.",
      "gloss": [
        {
          "sa": "अविनयम्",
          "en": "arrogance, lack of humility"
        },
        {
          "sa": "अपनय",
          "en": "remove"
        },
        {
          "sa": "विष्णो",
          "en": "O Viṣṇu"
        },
        {
          "sa": "दमय",
          "en": "discipline, subdue"
        },
        {
          "sa": "मनः",
          "en": "the mind"
        },
        {
          "sa": "शमय",
          "en": "quiet, calm"
        },
        {
          "sa": "विषय",
          "en": "sense objects"
        },
        {
          "sa": "मृगतृष्णाम्",
          "en": "mirage-thirst"
        },
        {
          "sa": "भूत-दयाम्",
          "en": "compassion for living beings"
        },
        {
          "sa": "विस्तारय",
          "en": "expand"
        },
        {
          "sa": "तारय",
          "en": "carry across, deliver"
        },
        {
          "sa": "संसार-सागरात्",
          "en": "from the ocean of worldly existence"
        }
      ],
      "iast": "avinayamapanaya viṣṇo damaya manaḥ śamaya viṣayamṛgatṛṣṇām |\nbhūtadayāṃ vistāraya tāraya saṃsārasāgarāt ||"
    },
    {
      "id": "shatpadi-2",
      "label": "Verse 2",
      "number": "2",
      "deva": "दिव्यधुनीमकरन्दे परिमलपरिभोगसच्चिदानन्दे ।\nश्रीपतिपदारविन्दे भवभयखेदच्छिदे वन्दे ॥",
      "translation": "I bow to the lotus feet of the Lord of Śrī: nectar from the celestial river, fragrant, and the enjoyment of Being, Consciousness, and Bliss; they cut away the fear and distress of worldly existence.",
      "gloss": [
        {
          "sa": "दिव्य",
          "en": "divine, celestial"
        },
        {
          "sa": "धुनी",
          "en": "river"
        },
        {
          "sa": "मकरन्दे",
          "en": "in the honey, nectar"
        },
        {
          "sa": "परिमल",
          "en": "fragrance"
        },
        {
          "sa": "परिभोग",
          "en": "enjoyment, experience"
        },
        {
          "sa": "सत्",
          "en": "Being"
        },
        {
          "sa": "चित्",
          "en": "Consciousness"
        },
        {
          "sa": "आनन्दे",
          "en": "in Bliss"
        },
        {
          "sa": "श्री-पति",
          "en": "Lord of Śrī, Viṣṇu"
        },
        {
          "sa": "पद-अरविन्दे",
          "en": "at the lotus feet"
        },
        {
