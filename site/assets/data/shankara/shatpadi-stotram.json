        },
        {
          "sa": "खेद",
          "en": "distress"
        },
        {
          "sa": "छिदे",
          "en": "to the cutter, remover"
        },
        {
          "sa": "वन्दे",
          "en": "I bow"
        }
      ],
      "iast": "divyadhunīmakarande parimalaparibhogasaccidānande |\nśrīpatipadāravinde bhavabhayakhedacchide vande ||"
    },
    {
      "id": "shatpadi-3",
      "label": "Verse 3",
      "number": "3",
      "deva": "सत्यपि भेदापगमे नाथ तवाहं न मामकीनस्त्वम् ।\nसामुद्रो हि तरङ्गः क्वचन समुद्रो न तारङ्गः ॥",
      "translation": "Even when difference has vanished, Lord, I am yours; you are not mine. A wave belongs to the sea, indeed; the sea is never the wave’s.",
      "gloss": [
        {
          "sa": "सति अपि",
          "en": "even when there is"
        },
        {
          "sa": "भेद-अपगमे",
          "en": "the disappearance of difference"
        },
        {
          "sa": "नाथ",
          "en": "O Lord"
        },
        {
          "sa": "तव अहम्",
          "en": "I am yours"
        },
        {
          "sa": "न",
          "en": "not"
        },
        {
          "sa": "मामकीनः",
          "en": "mine, belonging to me"
        },
        {
          "sa": "त्वम्",
          "en": "you"
        },
        {
          "sa": "सामुद्रः",
          "en": "belonging to the sea"
        },
        {
          "sa": "हि",
          "en": "indeed"
        },
        {
          "sa": "तरङ्गः",
          "en": "a wave"
        },
        {
          "sa": "क्वचन",
          "en": "anywhere, at all"
        },
        {
          "sa": "समुद्रः",
          "en": "the sea"
        },
        {
          "sa": "न तारङ्गः",
          "en": "not belonging to a wave"
        }
      ],
      "iast": "satyapi bhedāpagame nātha tavāhaṃ na māmakīnastvam |\nsāmudro hi taraṅgaḥ kvacana samudro na tāraṅgaḥ ||"
    },
    {
      "id": "shatpadi-4",
      "label": "Verse 4",
      "number": "4",
      "deva": "उद्धृतनग नगभिदनुज दनुजकुलामित्र मित्रशशिदृष्टे ।\nदृष्टे भवति प्रभवति न भवति किं भवतिरस्कारः ॥",
      "translation": "O lifter of the mountain, younger brother of Indra, enemy of the demon clans, whose eyes are the sun and moon! When you are seen, does turning away from worldly existence not prevail? What cannot then happen?",
      "gloss": [
        {
          "sa": "उद्धृत-नग",
          "en": "lifter of the mountain [Govardhana]"
        },
        {
          "sa": "नग-भिद्",
          "en": "mountain-breaker [Indra]"
        },
        {
          "sa": "अनुज",
          "en": "younger brother"
        },
        {
          "sa": "दनुज-कुल",
          "en": "the demon clans"
        },
        {
          "sa": "अमित्र",
          "en": "enemy"
        },
        {
          "sa": "मित्र • शशि • दृष्टे",
          "en": "sun • moon • eyed"
        },
        {
          "sa": "दृष्टे",
          "en": "when seen"
        },
        {
          "sa": "भवति",
          "en": "comes to be"
        },
        {
          "sa": "प्रभवति",
          "en": "prevails, takes effect"
        },
        {
          "sa": "न भवति किम्",
          "en": "what cannot happen?"
        },
        {
          "sa": "भव-तिरस्कारः",
          "en": "rejection of worldly existence"
        }
      ],
      "iast": "uddhṛtanaga nagabhidanuja danujakulāmitra mitraśaśidṛṣṭe |\ndṛṣṭe bhavati prabhavati na bhavati kiṃ bhavatiraskāraḥ ||"
    },
    {
      "id": "shatpadi-5",
      "label": "Verse 5",
      "number": "5",
      "deva": "मत्स्यादिभिरवतारैरवतारवतावता सदा वसुधाम् ।\nपरमेश्वर परिपाल्यो भवता भवतापभीतोऽहम् ॥",
      "translation": "With incarnations beginning with the Fish, you have always protected the earth. Supreme Lord, I am frightened by the fever of worldly existence; I should be protected by you.",
      "gloss": [
        {
          "sa": "मत्स्य-आदिभिः",
          "en": "by those beginning with the Fish"
        },
        {
          "sa": "अवतारैः",
          "en": "by incarnations"
        },
        {
          "sa": "अवतार-वता",
          "en": "by the one endowed with incarnations"
        },
