{"schema_version":1,"source_commit":"100560de6c9f68c2875097d40a2012a84c784179","scope":"Śrīmad-Bhāgavatam Canto 2, Chapter 4 — Śrīdhara Svāmī word-for-word gloss","source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","entries":[{"canto":2,"chapter":4,"start":1,"end":1,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["तुर्ये","in the fourth [canto]"],["परीक्षिता पृष्टम्","the questions asked by Parīkṣit"],["सृष्ट्य्-आदि हरि-चेष्टितम्","the acts of Hari beginning with creation"],["शुकेन","by Śuka"],["ब्रह्म-तत्-पुत्र-संवादेन","through the conversation between Brahmā and his son"],["राज्ञः प्रश्नम् कथयितुम्","to relate the king's question"],["तस्य प्राक्तनीं स्थितिम्","his previous condition"],["वैयासकेः शुकस्य","of Vyāsa's son, Śuka"],["आत्मनः तत्त्वस्य निश्चयः","certainty about the truth of the Self"],["तद्-वचः उपधार्य आकलय्य","having heard and understood those words"],["सतीं कृष्ण एव सेव्यो नान्यः","the conviction that only Kṛṣṇa is to be served, and no one else"]]},{"canto":2,"chapter":4,"start":2,"end":2,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["आत्मा देहः","the self means the body"],["पशवः गजादयः","animals are elephants and the like"]]},{"canto":2,"chapter":4,"start":3,"end":3,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["इमम् एवार्थम्","this very meaning"],["हरि-लीला-लक्षणम्","characterized by Hari's pastimes"]]},{"canto":2,"chapter":4,"start":4,"end":4,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["संस्थां मृत्युम्","the final state means death"],["त्रैवर्गिकम्","concerned chiefly with the three aims"],["धर्म-अर्थ-काम-प्रधानम्","chiefly concerned with duty, wealth and desire"],["सन्न्यस्य त्यक्त्वा","having renounced, having abandoned"],["आत्म-भावम्","the state of being the Self"],["परम-प्रेम्णा भगवद्-आत्मत्वम्","through supreme love, identity with Bhagavān"],["गतः प्राप्तः सन्","having attained"],["पप्रच्छ","he asked"]]},{"canto":2,"chapter":4,"start":5,"end":5,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["मह्यं मम","for me, mine"],["तमः अज्ञानम्","darkness means ignorance"],["विशीर्यते नश्यति","it is destroyed"],["तव कथयतः सतः","while you, the good one, are speaking"],["अतः समीचीनम्","therefore it is excellent"]]},{"canto":2,"chapter":4,"start":6,"end":6,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["पुनश् च वेदितुम् इच्छामि","I wish to know further"],["इदं दुर्विभाव्यम्","this is difficult to conceive"],["अवितर्क्यम्","beyond reasoning"],["विश्वं यथा सृजति","how he creates the universe"]]},{"canto":2,"chapter":4,"start":7,"end":8,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["गोपायति पालयति","he protects, he maintains"],["संयच्छते संहरते","he restrains, he withdraws"],["पुरु-शक्तिर् बहु-शक्तिमान्","possessing many powers"],["क्रीडन् यथा करोति","how he acts while playing"],["आत्मानं ब्रह्मादि-रूपिणम्","himself, taking forms beginning with Brahmā"],["क्रीडयन्","causing to play"],["विकरोति विविधं करोति","he transforms, he makes manifold"]],"note":"The pinned source gives one Śrīdhara commentary block for 2.4.7–8; the WFW range preserves that source grouping."},{"canto":2,"chapter":4,"start":9,"end":9,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["एकः पुरुष-रूपेण","the one [Lord] in the form of the Person"],["युगपत्","simultaneously"],["जन्मभिर् ब्रह्माद्य्-अवतारैः","through births as incarnations beginning with Brahmā"],["क्रमशः","successively"],["प्रकृतेः गुणान् गृह्णाति","he accepts the qualities of material nature"]]},{"canto":2,"chapter":4,"start":10,"end":10,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["विचिकित्सितम्","that which is doubted"],["सन्दिग्धम्","uncertain"],["शाब्दे ब्रह्मणि विचारेण","through inquiry into the Veda"],["निष्णातः","deeply versed"],["परस्मिन् अनुभवेन","in the Supreme through direct experience"]]},{"canto":2,"chapter":4,"start":11,"end":11,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["उपामन्त्रितः प्रार्थितः","invited, requested"],["प्रचक्रमे","he began"],["देवता-गुरु-नमस्कारादि-रूपम्","in the form of obeisance to the deity, guru and others"],["उपक्रमम्","an opening"],["कृतवान् इति अर्थः","that is, he performed"]]},{"canto":2,"chapter":4,"start":12,"end":12,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["परस्मै सर्वोत्तमाय","to the Supreme, the highest"],["भूयसे अपरिमित-महिम्ने","to the immensely glorious one"],["सतः प्रपञ्चस्य उद्भवादिषु","in the manifestation and other stages of the existent universe"],["निमित्त-भूता लीला","the pastime that is the cause"],["ब्रह्मादि-रूपेण","in forms beginning with Brahmā"],["रज-आदि शक्ति-त्रितयम्","the three powers beginning with rajas"],["अन्तर्भवाय अन्तर्यामिणे","to the inner controller who resides within"],["सर्वान्तरत्वात्","because he is within all"],["अनुपलक्ष्यं वर्त्म यस्य","whose way cannot be perceived"],["योगिभिर् अपि दुर्ज्ञेयम्","difficult to know even for yogīs"]]},{"canto":2,"chapter":4,"start":13,"end":13,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["विचित्र-फल-दातृत्वम्","his granting of diverse results"],["सतां धर्म-वर्तिनाम्","for the virtuous, who follow dharma"],["वृजिन-च्छिदे दुःख-हन्त्रे","to the cutter of sin, the remover of suffering"],["असताम् अधर्म-शीलानाम्","for the wicked, who are devoted to adharma"],["असंभवाय अनुद्भव-हेतवे","to the cause of their nonexistence, their not arising"],["अखिल-सत्त्व-मूर्तये","to him whose form comprises all beings"],["देवतादि-रूपेण तत्-तत्-फल-दाय","who grants each result in the forms of the deities and others"],["समग्र-सत्त्व-मूर्तये","to him whose form comprises the whole of existence"],["पूर्वोक्तोभय-वैलक्षण्यं","the distinction from both kinds mentioned earlier"]]},{"canto":2,"chapter":4,"start":14,"end":14,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["सात्त्वतां भक्तानाम्","of the devotees"],["ऋषभाय पालकाय","to the foremost, the protector"],["कुयोगिनां भक्ति-हीनानाम्","for the poor yogīs, those devoid of devotion"],["विदूरा काष्ठा दिग् अपि यस्य","whose farthest limit is but a direction far away"],["निर्दोषत्वाय","to show his freedom from fault"],["अचिन्त्यम् ऐश्वर्यम्","inconceivable majesty"],["निरस्तं साम्यम् अतिशयश् च यस्य","whose equality and superiority are both denied of all others"],["राधसा ऐश्वर्येण","by his sovereign power"],["स्व-धामनि स्व-स्वरूपे ब्रह्मणि रममाणाय","to him who delights in his own abode, his own nature, Brahman"]]},{"canto":2,"chapter":4,"start":15,"end":15,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["सर्व-साधनेभ्यः","among all spiritual practices"],["भक्तेः श्रैष्ट्यम्","the superiority of devotion"],["अर्हणं पूजनम्","worship means honoring"],["सुभद्रं मङ्गलम्","auspicious and blessed"],["श्रवः यशः यस्य","whose fame is heard"],["तस्मै","to him"]]},{"canto":2,"chapter":4,"start":16,"end":16,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["विचक्षणा विवेकिनः","the discerning, the wise"],["चरणयोः उपसादना","approaching and serving his feet"],["भजनात्","through worship"],["अन्तरात्मनो मनसः","of the mind, the inner self"],["उभयत्र इह च परत्र च","in both places, here and hereafter"],["सङ्गं व्युदस्य निरस्य","having cast away, removed attachment"],["गत-क्लमाः","free from exertion"]]},{"canto":2,"chapter":4,"start":17,"end":17,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["भक्ति-शून्यानाम्","for those devoid of devotion"],["सर्व-साधन-वैफल्यं","the failure of all spiritual practices"],["तपस्विनः","the ascetics"],["मनस्विनो योगिनः","the thoughtful, the yogīs"],["सुमङ्गलाः सदाचाराः","auspicious, of good conduct"],["तप-आद्य्-अर्पणं विना","without offering austerity and the rest"],["सुभद्र-श्रवसे","to him of blessed fame"],["यशः-श्रवणादेः प्राधान्य-ज्ञापनाय","to show the importance of hearing his fame"]]},{"canto":2,"chapter":4,"start":18,"end":18,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["भक्तेः परम-शुद्धि-हेतुत्वम्","devotion's being the cause of supreme purification"],["किरातादयः","the Kirātas and others"],["पाप-जातयः","classes of sinful people"],["कर्मतः पाप-रूपाः","sinful by their actions"],["यद्-उपाश्रयाः भागवताः","the devotees who take shelter of him"],["तद्-आश्रयाः सन्तः शुध्यन्ति","taking shelter of those devotees, they become purified"],["असम्भावना-शङ्काम् परिहरति","he removes the doubt that this could not happen"],["प्रभविष्णवे प्रभवन-शीलाय","to the powerful one, capable of making it happen"]]},{"canto":2,"chapter":4,"start":19,"end":19,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["सर्वोपास्यत्वम्","the fact that he is to be worshiped by all"],["आत्मवतां धीराणाम् आत्मा","the Self of the wise who know the self"],["आत्मत्वेन उपास्यः","to be worshiped as the Self"],["त्रयीमयत्वादि-विशेषणैः","through attributes such as being composed of the three Vedas"],["तत्-तन्-मार्गेण उपास्यत्वम्","the ways in which he is worshiped"],["गत-व्यलीकैः निष्कपटैः भक्तैः","by sincere devotees, free from deceit"],["वितर्क्यम्","to be contemplated"],["अत्याश्चर्येण वीक्षणीयम्","to be seen with great wonder"],["लिङ्गं मूर्तिर् यस्य","whose sign is his form"],["स प्रसीदतु","may he be pleased"]]},{"canto":2,"chapter":4,"start":20,"end":20,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["सर्व-पालकत्वम्","his being the protector of all"],["श्रियः इति","with the word ‘fortune’"],["गतिः च","and the refuge"],["सर्व-आपत्सु रक्षकः","the protector in every danger"]]},{"canto":2,"chapter":4,"start":21,"end":21,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["ज्ञान-प्रदत्वम्","his giving of knowledge"],["यस्य अङ्घ्र्योः अनुध्यानम् एव समाधिः","meditation on whose feet alone is samādhi"],["तेन धौतया शोधितया","by that which has been washed, purified"],["यथा-रुचम्","according to one's inclination"],["सगुण-निर्गुणादि-भेदैः","through distinctions such as with qualities and without qualities"],["रुक् प्रतिभा","ruk means insight"],["यथा-मति इति अर्थः","that is, according to one's understanding"]]},{"canto":2,"chapter":4,"start":22,"end":22,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["कल्पादौ","at the beginning of the kalpa"],["अजस्य हृदि","in the heart of the unborn one"],["सृष्टि-विषयाम्","concerning creation"],["येन प्रचोदिता सती","having been inspired by whom"],["सरस्वती तस्य मुखतः प्रादुर्भूता","Sarasvatī appeared from his mouth"],["स्वानि लक्षणानि","her own characteristics"],["शिक्षा-आदि-उक्तानि","stated in the Śikṣā and other works"],["ऋषीणां ज्ञान-प्रदानाम्","the bestower of knowledge to the sages"],["ऋषभः श्रेष्ठः","the foremost, the best"]]},{"canto":2,"chapter":4,"start":23,"end":23,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["स्व-वाच्यम्","his own words"],["श्रोतृ-जन-आह्लादिनीम्","delighting the hearers"],["शृङ्गार-करुणादि-शोभाम्","beautiful with love, compassion and the other sentiments"],["स मे वचांसि अलङ्कृषीष्ट","may he adorn my words"],["अन्योन्य-अलङ्कार-असम्भवम्","the impossibility of adorning one another"],["अन्तर्यामिताम् आविष्करोति","he reveals his status as the inner controller"],["महद्भिर् भूतैः","with the great elements"],["शरीराणि सृष्ट्वा","having created bodies"],["अन्तर्यामितया शेते वसति","he dwells within as the inner controller"],["षोडश-गुणान् कलाः","the sixteen principles"],["भुङ्क्ते प्रकाशयति पालयति","he enjoys, manifests or protects them"],["षोडशानाम् आत्मा चेतयिता","the conscious self of the sixteen elements"]]},{"canto":2,"chapter":4,"start":24,"end":24,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["श्री-व्यासम् नमस्करोति","he offers obeisance to Śrī Vyāsa"],["सौम्याः भक्ताः","gentle devotees"],["यस्य मुख-अम्बुरुहे","in whose lotus-mouth"],["आसवः मकरन्दः","the nectar is honey"],["तम्","to him"]]},{"canto":2,"chapter":4,"start":25,"end":25,"source_path":"bhAgavatam/gauDIya-prastutiH/02/04_kathArambhaH.md","source_blob_sha":"9c72ceb65636bb64d541ac48caaff76b93b6f53f","pairs":[["प्रश्नोत्तर-तया","in the form of question and answer"],["ब्रह्म-नारद-संवादम्","the conversation between Brahmā and Nārada"],["उत्पत्ति-समय एव","at the very time of birth"],["वेदाः गर्भे यस्य","the Vedas were in whose womb"],["साक्षाद् हरिः","Hari himself"],["यद् आह तद् आह","he said what Hari had said"]]}]}